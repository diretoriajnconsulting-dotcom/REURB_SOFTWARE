# =============================================================
# DATA HUB FUNDIARIO — .gitignore
# =============================================================

# Ambiente e segredos
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# IDEs
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Java / Maven
services/*/target/
*.class
*.jar
*.war
*.ear

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
venv/
.venv/
*.whl

# Node.js
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker
docker-compose.override.yml

# Dados locais
postgres_data/
geoserver_data/
minio_data/
redis_data/

# Logs
*.log
logs/

# Testes
coverage/
.coverage
htmlcov/
.pytest_cache/
.tox/

# Build
*.o
*.so
*.dylib
